{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build .mrpack",
      "type": "shell",
      "command": "python tools/modpack.py build",
      "dependsOn": "Build companion mod",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Build companion mod",
      "type": "shell",
      "command": "./gradlew build",
      "windows": { "command": ".\\gradlew.bat build" },
      "options": {
        "cwd": "${workspaceFolder}/companion-mod",
        "env": { "JAVA_HOME": "${env:USERPROFILE}\\.jdks\\jdk-25.0.4.1+1" }
      },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python -m unittest discover -s tests -v",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Update all mods",
      "type": "shell",
      "command": "python tools/modpack.py update",
      "problemMatcher": []
    },
    {
      "label": "Configure instance (dry run)",
      "type": "shell",
      "command": "python tools/configure.py --dry-run --verbose",
      "problemMatcher": []
    },
    {
      "label": "Configure instance",
      "type": "shell",
      "command": "python tools/configure.py",
      "problemMatcher": []
    },
    {
      "label": "Update one mod",
      "type": "shell",
      "command": "python tools/modpack.py update ${input:slugs}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "slugs",
      "type": "promptString",
      "description": "Modrinth slug(s) to update, space-separated (e.g. skyhanni odin)"
    }
  ]
}
